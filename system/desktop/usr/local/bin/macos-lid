#!/bin/bash
# What the laptop does when the lid closes, for System Settings > Battery
# (Quickshell MacOS/SettingsWindow.qml). Installed as /usr/local/bin/macos-lid
# and run as root through pkexec (policy: org.macos-look.lid).
#
#   macos-lid BATTERY PLUGGED_IN EXTERNAL_DISPLAY
#
# Each value is one of: ignore suspend lock poweroff. Writes a logind drop-in
# and tells logind to reload it.
set -eu

CONF=/etc/systemd/logind.conf.d/50-macos-lid.conf

if [ $# -ne 3 ]; then
    echo "usage: macos-lid BATTERY PLUGGED_IN EXTERNAL_DISPLAY" >&2
    exit 2
fi
for v in "$@"; do
    case "$v" in
        ignore|suspend|lock|poweroff) ;;
        *) echo "macos-lid: unknown action: $v" >&2; exit 2 ;;
    esac
done

mkdir -p "${CONF%/*}"
cat > "$CONF" <<CONF
# Written by System Settings > Battery (macos-lid). Change it there.
[Login]
HandleLidSwitch=$1
HandleLidSwitchExternalPower=$2
HandleLidSwitchDocked=$3
CONF
systemctl kill -s HUP systemd-logind
