#!/bin/bash
# What the laptop does when the lid closes, for System Settings > Battery
# (Quickshell Clave/SettingsWindow.qml). Installed as /usr/local/bin/clave-lid
# and run as root through pkexec (policy: org.clave.lid).
#
#   clave-lid BATTERY PLUGGED_IN EXTERNAL_DISPLAY
#
# Each value is one of: ignore suspend lock poweroff. Writes a logind drop-in
# and tells logind to reload it.
set -eu

CONF=/etc/systemd/logind.conf.d/50-clave-lid.conf

if [ $# -ne 3 ]; then
    echo "usage: clave-lid BATTERY PLUGGED_IN EXTERNAL_DISPLAY" >&2
    exit 2
fi
for v in "$@"; do
    case "$v" in
        ignore|suspend|lock|poweroff) ;;
        *) echo "clave-lid: unknown action: $v" >&2; exit 2 ;;
    esac
done

mkdir -p "${CONF%/*}"
cat > "$CONF" <<CONF
# Written by System Settings > Battery (clave-lid). Change it there.
[Login]
HandleLidSwitch=$1
HandleLidSwitchExternalPower=$2
HandleLidSwitchDocked=$3
CONF
systemctl kill -s HUP systemd-logind
