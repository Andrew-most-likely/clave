#!/bin/bash
# System settings that need root, for System Settings (Quickshell
# MacOS/SettingsWindow.qml). Installed as /usr/local/bin/macos-admin and run
# through pkexec with no password (polkit action org.macos-look.admin), so
# every argument is checked here.
#
#   macos-admin charge-limit PERCENT|off   stop charging at PERCENT (50-100)
#   macos-admin timezone ZONE              e.g. America/New_York
#   macos-admin ntp on|off                 set time automatically
#   macos-admin usb-list                   USBGuard devices, one per line
set -eu

BAT=/sys/class/power_supply/BAT0/charge_control_end_threshold
CHARGE_CONF=/etc/tmpfiles.d/macos-charge-limit.conf

case "${1:-}" in
    charge-limit)
        v=${2:-}
        if [ "$v" = off ]; then
            rm -f "$CHARGE_CONF"
            echo 100 > "$BAT"
        elif [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge 50 ] && [ "$v" -le 100 ]; then
            # tmpfiles writes it again at every boot.
            echo "w $BAT - - - - $v" > "$CHARGE_CONF"
            echo "$v" > "$BAT"
        else
            echo "macos-admin: bad charge limit: $v" >&2; exit 2
        fi ;;
    timezone)
        z=${2:-}
        if ! timedatectl list-timezones | grep -qxF -- "$z"; then
            echo "macos-admin: unknown time zone: $z" >&2; exit 2
        fi
        timedatectl set-timezone "$z" ;;
    ntp)
        case "${2:-}" in
            on)  timedatectl set-ntp true ;;
            off) timedatectl set-ntp false ;;
            *)   echo "macos-admin: ntp on|off" >&2; exit 2 ;;
        esac ;;
    usb-list)
        usbguard list-devices ;;
    *)
        echo "usage: macos-admin charge-limit|timezone|ntp|usb-list ..." >&2; exit 2 ;;
esac
