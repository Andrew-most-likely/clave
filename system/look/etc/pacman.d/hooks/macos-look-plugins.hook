# Rebuild the macOS look's Hyprland plugins (hyprbars traffic lights,
# hypr-minimize genie) whenever Hyprland is upgraded. Plugins only load into
# the exact Hyprland they were built against. Runs as __USER__, not root.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = hyprland

[Action]
Description = Rebuilding macOS look Hyprland plugins...
When = PostTransaction
Exec = /usr/bin/runuser -u __USER__ -- /usr/bin/env HOME=__HOME__ XDG_RUNTIME_DIR=/run/user/__UID__ DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/__UID__/bus __HOME__/.local/share/macos-look/rebuild-plugins.sh
