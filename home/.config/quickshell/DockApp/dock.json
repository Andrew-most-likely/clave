/*
Shipped Dock defaults. Do not edit: updates replace this file.

The Dock reads this file, then ~/.config/clave/dock.json on top of it.
System Settings > Desktop & Dock and pinning or unpinning apps write that
second file. Values missing from both fall back to defaultSettings in
DockSettings.qml.

"clave-apps" in the pinned list is the Apps button; the other entries are
desktop file IDs (the name of the .desktop file without the extension).
*/
{
    "dock": {
        "enabled": true,
        "autohide": false,
        "iconSize": 52,
        "spacing": 2,
        "marginBottom": 6,
        "reserveSpace": true,
        "hideDelay": 400,
        "showIndicators": true
    },
    "pill": {
        "radius": 20,
        "padding": 4,
        "animationDuration": 350
    },
    "border": {
        "width": 2,
        "colorTop": "",
        "colorBottom": ""
    },
    "opacity": {
        "normal": 0.7
    },
    "magnification": {
        "enabled": true,
        "maxScale": 1.6,
        "range": 3
    },
    "apps": {
        "pinned": [
            "org.gnome.Nautilus",
            "clave-apps",
            "firefox",
            "kitty",
            "org.gnome.TextEditor",
            "org.gnome.Calculator"
        ]
    }
}
