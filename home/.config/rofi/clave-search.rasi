/* Search */
configuration {
    modi:                "drun,run";
    show-icons:          true;
    icon-theme:          "Clave-icons-dark";
    display-drun:        "";
    drun-display-format: "{name}";
    font:                "Inter 13";
}
* {
    bg:        rgba(38, 38, 40, 78%);
    border-c:  rgba(255, 255, 255, 14%);
    fg:        #f2f2f7;
    fg-dim:    rgba(235, 235, 245, 55%);
    accent:    #0a84ff;
    background-color: transparent;
    text-color:       @fg;
}
window {
    location:        north;
    anchor:          north;
    y-offset:        22%;
    width:           680px;
    border:          1px;
    border-color:    @border-c;
    border-radius:   14px;
    background-color: @bg;
    padding:         0;
}
mainbox { children: [ inputbar, listview ]; spacing: 0; }
/* The calculator's result (clave-search), and the Apps / Calculator switch. */
message {
    padding:   12px 18px;
    border:    0 0 1px 0;
    border-color: @border-c;
}
textbox {
    font:      "Inter Display 18";
    text-color: @fg;
}
mode-switcher {
    padding:   6px;
    spacing:   6px;
    border:    1px 0 0 0;
    border-color: @border-c;
}
button {
    padding:   5px 10px;
    border-radius: 8px;
    text-color: @fg-dim;
}
button selected {
    background-color: @accent;
    text-color: #ffffff;
}
inputbar {
    children:  [ icon-search, entry ];
    padding:   14px 18px;
    spacing:   12px;
    border:    0 0 1px 0;
    border-color: @border-c;
}
icon-search {
    expand:    false;
    filename: "__HOME__/.config/quickshell/Clave/icons/search.svg";
    size:      22px;
    vertical-align: 0.5;
}
entry {
    placeholder:       "Search";
    placeholder-color: @fg-dim;
    font:              "Inter Display 20";
    vertical-align:    0.5;
    cursor:            text;
}
listview {
    lines:     8;
    columns:   1;
    padding:   6px;
    spacing:   2px;
    fixed-height: false;
    scrollbar: false;
}
element {
    padding:       7px 10px;
    spacing:       12px;
    border-radius: 7px;
}
element selected.normal, element selected.active { background-color: @accent; text-color: #ffffff; }
element-icon { size: 28px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
