/* rofi defaults. Search, Apps and the pickers pass their own -theme;
   anything else that opens rofi gets the Search look. */
configuration {
    modi:                "drun,run,window";
    font:                "Inter 11";
    show-icons:          true;
    drun-display-format: "{name}";
    window-format:       "{w} · {c} · {t}";
    hover-select:        false;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    click-to-exit:       true;
    kb-cancel:           "Escape,MousePrimary";
}

@theme "clave-search.rasi"
