/* Apps */
configuration {
    modi:                "drun";
    show-icons:          true;
    icon-theme:          "WhiteSur-dark";
    display-drun:        "";
    drun-display-format: "{name}";
    font:                "Inter 12";
}
* {
    fg:     #ffffff;
    fg-dim: rgba(255, 255, 255, 60%);
    background-color: transparent;
    text-color:       @fg;
}
window {
    fullscreen:       true;
    background-color: rgba(20, 20, 24, 45%);
    padding:          5% 12%;
}
mainbox { children: [ inputbar, listview ]; spacing: 40px; }
inputbar {
    children:         [ icon-search, entry ];
    expand:           false;
    margin:           0 590px;
    padding:          6px 12px;
    spacing:          8px;
    border-radius:    8px;
    border:           1px;
    border-color:     rgba(255, 255, 255, 18%);
    background-color: rgba(255, 255, 255, 12%);
}
icon-search { expand: false; filename: "__HOME__/.config/quickshell/Clave/icons/search.svg"; size: 14px; vertical-align: 0.5; }
entry { placeholder: "Search"; placeholder-color: @fg-dim; vertical-align: 0.5; }
listview {
    columns:      7;
    lines:        5;
    spacing:      28px;
    fixed-height: true;
    scrollbar:    false;
    flow:         horizontal;
}
element {
    orientation:   vertical;
    padding:       14px 6px;
    spacing:       10px;
    border-radius: 16px;
}
element selected.normal, element selected.active { background-color: rgba(255, 255, 255, 14%); }
element-icon { size: 80px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; text-color: inherit; }
