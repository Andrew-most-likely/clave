#!/usr/bin/env bash
# Sets the desktop picture on every screen (awww) and prepares the lock screen
# images (hyprlock).
#
#   clave-wallpaper IMAGE        IMAGE is a path or a file:// URI
#   clave-wallpaper --random     a random picture from the wallpaper folders
#   clave-wallpaper --restore    the last picture (used at login)
#   clave-wallpaper --current    print the current picture
#   clave-wallpaper --lock       only make the lock screen picture again
#
# Wallpaper folders: ~/.local/share/clave/wallpapers, ~/Pictures/Wallpapers
#
# The lock screen shows a blurred copy of the wallpaper, or the picture chosen
# in System Settings > Lock Screen (settings.json lockScreen.background =
# "picture", kept as ~/.local/share/clave/lock-background.png by clave-prefs).
set -euo pipefail

state=~/.config/clave/wallpaper
cache=~/.cache/clave
dirs=(~/.local/share/clave/wallpapers ~/Pictures/Wallpapers)
saved=~/.local/share/clave/wallpapers/saved
lockpic=~/.local/share/clave/lock-background.png

# The lock screen picture, in ~/.cache/clave/lock.png for hyprlock.
make_lock() {  # make_lock CODER IMAGE
    mkdir -p "$cache"
    if [ "$(jq -r '.lockScreen.background // "wallpaper"' ~/.config/clave/settings.json 2>/dev/null)" = picture ] \
            && [ -f "$lockpic" ]; then
        cp -f -- "$lockpic" "$cache/lock.png.tmp"
    else
        # A blurred, darker copy of the wallpaper.
        magick "$1:$2" -resize 50% -blur 0x30 -fill black -colorize 15% "png:$cache/lock.png.tmp"
    fi && mv -f "$cache/lock.png.tmp" "$cache/lock.png"
}

list() { find "${dirs[@]}" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null; }

case "${1:-}" in
    --random)  img=$(list | grep -vxF "$(cat "$state" 2>/dev/null)" | shuf -n1 || true) ;;
    --restore) img=$(cat "$state" 2>/dev/null || true)
               [ -f "$img" ] || img=$(list | grep -i 'whitesur-dark' | head -n1 || true)
               [ -f "$img" ] || img=$(list | head -n1 || true) ;;
    --current) cat "$state" 2>/dev/null; exit ;;
    --lock)    lock_only=1; img=$(cat "$state" 2>/dev/null || true)
               # A chosen picture needs no wallpaper.
               if [ ! -f "$img" ]; then make_lock "" ""; exit; fi ;;
    ""|-h|--help) sed -n '2,11p' "$0" | cut -c3-; exit 1 ;;
    file://*)  img=$(python3 -c 'import sys, urllib.parse as u; print(u.unquote(u.urlparse(sys.argv[1]).path))' "$1") ;;
    *)         img=$1 ;;
esac
[ -n "${img:-}" ] && [ -f "$img" ] || { echo "clave-wallpaper: no image found" >&2; exit 1; }
img=$(realpath "$img")

# Pictures can come from other apps (the wallpaper portal): decode only JPEG,
# PNG and WebP, told explicitly, so ImageMagick never guesses another coder.
case "$(file --brief --mime-type -- "$img")" in
    image/jpeg) coder=jpeg ;;
    image/png)  coder=png ;;
    image/webp) coder=webp ;;
    *) echo "clave-wallpaper: not a JPEG, PNG or WebP picture" >&2; exit 1 ;;
esac

if [ -n "${lock_only:-}" ]; then make_lock "$coder" "$img"; exit; fi

# Apps hand over temporary files; keep a copy so the picture survives a reboot.
case "$img" in
    /tmp/*|"$HOME"/.cache/*|/run/*)
        mkdir -p "$saved"
        copy="$saved/$(date +%Y%m%d-%H%M%S)-$(basename "$img")"
        cp -n -- "$img" "$copy"
        img=$copy ;;
esac

# awww-daemon may still be starting at login.
for _ in $(seq 50); do awww query >/dev/null 2>&1 && break; sleep 0.1; done
awww img "$img" --resize crop --transition-type fade --transition-duration 0.6

mkdir -p "$(dirname "$state")" "$cache"
printf '%s\n' "$img" > "$state"

# Lock screen: in the background, because blurring takes a second on large
# pictures.
make_lock "$coder" "$img" >/dev/null 2>&1 &
