#!/usr/bin/env python3
"""Idle timeouts for System Settings > Lock Screen (Quickshell SettingsWindow).

  clave-idle get                        prints lock=SEC display=SEC sleep=SEC (0 = never)
  clave-idle set LOCK DISPLAY SLEEP     seconds, 0 = never; rewrites
                                        ~/.config/hypr/hypridle.conf and restarts hypridle

Listeners are recognised by their on-timeout command: lock-session (lock),
dpms disable (display), suspend (sleep), brightnessctl -s (dim, kept one
minute before the lock).
"""
import os
import re
import subprocess
import sys

CONF = os.path.expanduser("~/.config/hypr/hypridle.conf")
NEVER = 31536000  # one year stands in for "never"


def kind(block):
    m = re.search(r"on-timeout\s*=\s*(.*)", block)
    cmd = m.group(1) if m else ""
    if "lock-session" in cmd:
        return "lock"
    if "dpms" in cmd and "disable" in cmd:
        return "display"
    if "suspend" in cmd:
        return "sleep"
    if "brightnessctl -s" in cmd:
        return "dim"
    return None


def blocks(text):
    # Only real blocks: "listener {" at the start of a line (commented-out
    # "# listener {" examples are skipped).
    return list(re.finditer(r"^listener\s*\{.*?^\}", text, re.S | re.M))


def get():
    text = open(CONF).read()
    out = {}
    for b in blocks(text):
        k = kind(b.group(0))
        t = re.search(r"timeout\s*=\s*(\d+)", b.group(0))
        if k and t:
            v = int(t.group(1))
            out[k] = 0 if v >= NEVER else v
    print(" ".join(f"{k}={out.get(k, 0)}" for k in ("lock", "display", "sleep")))


def set_(lock, display, sleep):
    want = {"lock": lock or NEVER, "display": display or NEVER, "sleep": sleep or NEVER}
    want["dim"] = NEVER if not lock else max(30, lock - 60)
    text = open(CONF).read()
    out, last = [], 0
    for b in blocks(text):
        k = kind(b.group(0))
        block = b.group(0)
        if k in want:
            v = want[k]
            note = "never" if v >= NEVER else (f"{v // 60}min" if v % 60 == 0 else f"{v}s")
            block = re.sub(r"(?m)^(\s*timeout\s*=\s*)\d+.*$",
                           lambda m: f"{m.group(1)}{v}  # {note} (System Settings > Lock Screen)",
                           block, count=1)
        out.append(text[last:b.start()])
        out.append(block)
        last = b.end()
    out.append(text[last:])
    open(CONF, "w").write("".join(out))
    subprocess.run(["pkill", "-x", "hypridle"])
    subprocess.Popen(["hypridle"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] == "get":
        get()
    elif len(sys.argv) == 5 and sys.argv[1] == "set":
        set_(*(int(a) for a in sys.argv[2:5]))
    else:
        print(__doc__)
        sys.exit(1)
