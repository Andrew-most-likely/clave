#!/usr/bin/env python3
"""Backend for the newer System Settings panes (Quickshell Clave/SettingsWindow.qml).
Every "get" prints JSON; everything else changes one setting.

  clave-prefs usb                          USBGuard devices (root hubs left out)
  clave-prefs battery                      health, cycles, charge limit, power mode
  clave-prefs time                         time zone and automatic time
  clave-prefs zones                        all time zones
  clave-prefs notify get                   do not disturb, muted apps, banner time
  clave-prefs notify dnd on|off
  clave-prefs notify app NAME on|off       allow or mute one app's notifications
  clave-prefs notify timeout SECONDS
  clave-prefs printers get                 printers and the default one
  clave-prefs printers default NAME
  clave-prefs login get                    apps started at login (XDG autostart)
  clave-prefs login set FILE on|off
  clave-prefs login add DESKTOP_FILE
  clave-prefs login remove FILE
  clave-prefs appearance get
  clave-prefs appearance mode light|dark   GTK 3/4, Qt (Kvantum), icons, flatpak
  clave-prefs appearance accent NAME       blue purple pink red orange yellow green graphite
  clave-prefs appearance text-scale FACTOR
  clave-prefs loginwindow background FILE|wallpaper   login screen background
  clave-prefs loginwindow picture FILE                profile picture (also ~/.face)
  clave-prefs lockscreen background wallpaper|FILE    lock screen: blurred wallpaper or a picture
  clave-prefs apps names                   standard app names, custom icons, hidden helpers (APP-4, APP-10)
  clave-prefs apps defaults [--missing-only]   default apps for file types (APP-5)
  clave-prefs apps unexpected PKG...       visible launchers of these packages that no list covers (APP-10)
  clave-prefs icon set APP_ID FILE         a local PNG or SVG as an app's icon
  clave-prefs icon reset APP_ID

Root-only changes go through pkexec /usr/local/bin/clave-admin (charge limit, login
pictures) and
clave-usb (asks for the password); time settings use systemd's own polkit rules.
"""
import configparser
import glob
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))


def sh(*cmd, check=False):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        if check:
            sys.exit(f"{cmd[0]} is not installed")
        return ""
    if check and r.returncode != 0:
        sys.exit(r.stderr.strip() or f"{cmd[0]} failed")
    return r.stdout


def out(v):
    print(json.dumps(v))


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


# ---------------------------------------------------------------- USB

USB_RE = re.compile(r'^(\d+): (allow|block|reject) id (\S+) serial "([^"]*)" name "([^"]*)"'
                    r'.*?via-port "([^"]*)" with-interface (\{[^}]*\}|\S+)')


def usb_name(vid):
    """Product name from the hwdata USB list, for devices that report none."""
    v, p = vid.split(":")
    vendor = None
    try:
        with open("/usr/share/hwdata/usb.ids", encoding="latin-1") as f:
            for line in f:
                if not line.startswith("\t") and line.startswith(v + " "):
                    vendor = line[5:].strip()
                elif vendor and line.startswith("\t" + p + " "):
                    return f"{vendor.split()[0]} {line[6:].strip()}"
                elif vendor and not line.startswith("\t") and line.strip():
                    break
    except OSError:
        pass
    return vid


def usb():
    devs = []
    for line in sh("usbguard", "list-devices").splitlines():
        m = USB_RE.match(line)
        if not m or m.group(3).startswith("1d6b:"):  # Linux root hubs
            continue
        ifaces = m.group(7).strip("{} ").split()
        kinds = {i[:2] for i in ifaces}
        kind = ("Audio" if "01" in kinds else "Input device" if "03" in kinds
                else "Hub" if kinds == {"09"} else "Storage" if "08" in kinds
                else "Network" if "02" in kinds or m.group(3) in ("0bda:8153",)
                else "Camera" if "0e" in kinds else "Wireless" if "e0" in kinds
                else "Device")
        devs.append({"id": int(m.group(1)), "state": m.group(2), "vid": m.group(3),
                     "name": m.group(5) or usb_name(m.group(3)), "port": m.group(6), "kind": kind})
    out(devs)


# ---------------------------------------------------------------- Battery / time

def system_battery():
    """The laptop battery: type Battery, not a device's (mouse, pen)."""
    for b in sorted(glob.glob("/sys/class/power_supply/*/")):
        if read(b + "type", "") == "Battery" and read(b + "scope", "System") != "Device":
            return b
    return None


def battery():
    b = system_battery()
    if not b:
        out({"health": 0, "cycles": 0, "limit": 100, "profile": "", "profiles": []})
        return
    # Some batteries report energy (µWh) instead of charge (µAh).
    kind = "charge" if os.path.exists(b + "charge_full") else "energy"
    full, design = read(b + kind + "_full", "0"), read(b + kind + "_full_design", "0")
    health = round(100 * int(full) / int(design)) if int(design) else 0
    out({"health": health, "cycles": int(read(b + "cycle_count", "0") or 0),
         "limit": int(read(b + "charge_control_end_threshold", "100") or 100),
         "profile": sh("powerprofilesctl", "get").strip(),
         "profiles": re.findall(r"^[ *] (\S+):", sh("powerprofilesctl", "list"), re.M)})


def time_():
    zone = sh("timedatectl", "show", "-p", "Timezone", "--value").strip()
    ntp = sh("timedatectl", "show", "-p", "NTP", "--value").strip() == "yes"
    out({"zone": zone, "ntp": ntp})


# ---------------------------------------------------------------- Notifications (swaync)

SWAYNC = os.path.join(CONFIG, "swaync/config.json")
MUTE_PREFIX = "clave-mute: "


def swaync_load():
    with open(SWAYNC) as f:
        return json.load(f)


def swaync_save(cfg):
    write(SWAYNC, json.dumps(cfg, indent=2) + "\n")
    sh("swaync-client", "--reload-config")


def notify(args):
    if args[:1] == ["get"]:
        cfg = swaync_load()
        muted = [k[len(MUTE_PREFIX):] for k in cfg.get("notification-visibility", {})
                 if k.startswith(MUTE_PREFIX)]
        dnd = sh("swaync-client", "--get-dnd").strip() == "true"
        out({"dnd": dnd, "muted": muted, "timeout": cfg.get("timeout", 4)})
    elif args[:1] == ["dnd"] and len(args) == 2:
        sh("swaync-client", "--dnd-on" if args[1] == "on" else "--dnd-off")
    elif args[:1] == ["app"] and len(args) == 3:
        cfg = swaync_load()
        vis = cfg.setdefault("notification-visibility", {})
        key = MUTE_PREFIX + args[1]
        if args[2] == "off":
            vis[key] = {"state": "ignored", "app-name": "^" + re.escape(args[1]) + "$"}
        else:
            vis.pop(key, None)
        swaync_save(cfg)
    elif args[:1] == ["timeout"] and len(args) == 2:
        cfg = swaync_load()
        cfg["timeout"] = int(args[1])
        swaync_save(cfg)
    else:
        sys.exit(__doc__)


# ---------------------------------------------------------------- Printers (CUPS)

def printers(args):
    if args[:1] == ["get"]:
        default = ""
        m = re.search(r"destination: (\S+)", sh("lpstat", "-d"))
        if m:
            default = m.group(1)
        user_default = re.search(r"^Default (\S+)", read(os.path.join(HOME, ".cups/lpoptions")), re.M)
        if user_default:
            default = user_default.group(1)
        ps = []
        for line in sh("lpstat", "-p").splitlines():
            m = re.match(r"printer (\S+) (?:is )?(idle|now printing|disabled)", line)
            if m:
                ps.append({"name": m.group(1), "state": m.group(2), "default": m.group(1) == default})
        jobs = len([l for l in sh("lpstat", "-o").splitlines() if l.strip()])
        out({"printers": ps, "jobs": jobs})
    elif args[:1] == ["default"] and len(args) == 2:
        sh("lpoptions", "-d", args[1], check=True)
    else:
        sys.exit(__doc__)


# ---------------------------------------------------------------- Login items (XDG autostart)

USER_AUTOSTART = os.path.join(CONFIG, "autostart")
SYS_AUTOSTART = "/etc/xdg/autostart"


def desktop(path):
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    try:
        cp.read(path)
        return dict(cp["Desktop Entry"])
    except (configparser.Error, KeyError, UnicodeDecodeError):
        return {}


def login(args):
    if args[:1] == ["get"]:
        items = {}
        for d, system in ((SYS_AUTOSTART, True), (USER_AUTOSTART, False)):
            for p in sorted(glob.glob(os.path.join(d, "*.desktop"))):
                e = desktop(p)
                f = os.path.basename(p)
                if not e:
                    continue
                if not system and f in items:  # user file overrides the system one
                    items[f]["enabled"] = e.get("Hidden", "false") != "true"
                    continue
                if "Hyprland" in e.get("NotShowIn", "").split(";"):
                    continue
                only = [x for x in e.get("OnlyShowIn", "").split(";") if x]
                if only and "Hyprland" not in only:
                    continue
                items[f] = {"file": f, "name": e.get("Name", f), "system": system,
                            "enabled": e.get("Hidden", "false") != "true"
                            and e.get("X-GNOME-Autostart-enabled", "true") != "false"}
        out(sorted(items.values(), key=lambda i: i["name"].lower()))
    elif args[:1] == ["set"] and len(args) == 3:
        f, on = os.path.basename(args[1]), args[2] == "on"
        user = os.path.join(USER_AUTOSTART, f)
        sysf = os.path.join(SYS_AUTOSTART, f)
        if os.path.islink(user) or not os.path.exists(user):
            # Symlink or no user file: start from the real file's text.
            src = os.path.realpath(user) if os.path.exists(user) else sysf
            text = open(src).read()
            if os.path.islink(user):
                os.unlink(user)
        else:
            text = open(user).read()
        text = re.sub(r"^Hidden=.*\n?", "", text, flags=re.M)
        if not on:
            text = re.sub(r"^\[Desktop Entry\]\n", "[Desktop Entry]\nHidden=true\n", text, count=1, flags=re.M)
        write(user, text)
    elif args[:1] == ["add"] and len(args) == 2:
        # A path, or a desktop id (firefox.desktop) looked up like app launchers do.
        src = args[1]
        if not os.path.isfile(src):
            dirs = [os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share"))]
            dirs += os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
            name = src if src.endswith(".desktop") else src + ".desktop"
            src = next((os.path.join(d, "applications", name) for d in dirs
                        if os.path.isfile(os.path.join(d, "applications", name))), "")
            if not src:
                sys.exit(f"no such app: {args[1]}")
        dst = os.path.join(USER_AUTOSTART, os.path.basename(src))
        os.makedirs(USER_AUTOSTART, exist_ok=True)
        if os.path.lexists(dst):
            os.unlink(dst)
        os.symlink(src, dst)
    elif args[:1] == ["remove"] and len(args) == 2:
        p = os.path.join(USER_AUTOSTART, os.path.basename(args[1]))
        if os.path.lexists(p):
            os.unlink(p)
    else:
        sys.exit(__doc__)


# ---------------------------------------------------------------- Appearance

THEMES = {
    "dark":  {"gtk": "WhiteSur-Dark", "icons": "Clave-icons-dark", "kvantum": "WhiteSurDark",
              "gtk4css": "WhiteSur-Dark/gtk-4.0/gtk-dark.css", "scheme": "prefer-dark"},
    "light": {"gtk": "WhiteSur-Light", "icons": "Clave-icons", "kvantum": "WhiteSur",
              "gtk4css": "WhiteSur-Light/gtk-4.0/gtk.css", "scheme": "prefer-light"},
}


def gtk4_css(mode):
    """gtk-4.0/gtk.css: WhiteSur for the mode, then Clave's own rules (APP-3)
    for traffic-light window buttons, header bars, sidebars and radius."""
    t = THEMES[mode]
    return (f"/* Clave: WhiteSur {mode} for libadwaita apps, then clave.css (APP-3) */\n"
            f'@import url("file://{HOME}/.local/share/themes/{t["gtk4css"]}");\n'
            f'@import url("file://{CONFIG}/gtk-4.0/clave.css");\n')


def set_ini(path, key, value):
    text = read(path)
    if not text:
        return
    if re.search(rf"^{re.escape(key)}\s*=", text, re.M):
        text = re.sub(rf"^{re.escape(key)}\s*=.*$", f"{key}={value}", text, flags=re.M)
    else:
        text = text.rstrip("\n") + f"\n{key}={value}"
    write(path, text + "\n")


ACCENTS = {"blue": "blue", "purple": "purple", "pink": "pink", "red": "red", "orange": "orange",
           "yellow": "yellow", "green": "green", "graphite": "slate"}


def appearance(args):
    iface = "org.gnome.desktop.interface"
    if args[:1] == ["get"]:
        scheme = sh("gsettings", "get", iface, "color-scheme").strip().strip("'")
        scale = float(sh("gsettings", "get", iface, "text-scaling-factor").strip() or 1)
        out({"mode": "light" if scheme == "prefer-light" else "dark", "textScale": scale})
    elif args[:1] == ["mode"] and len(args) == 2 and args[1] in THEMES:
        t, dark = THEMES[args[1]], args[1] == "dark"
        for v in ("gtk-3.0", "gtk-4.0"):
            ini = os.path.join(CONFIG, v, "settings.ini")
            set_ini(ini, "gtk-theme-name", t["gtk"])
            set_ini(ini, "gtk-icon-theme-name", t["icons"])
            set_ini(ini, "gtk-application-prefer-dark-theme",
                    ("1" if dark else "0") if v == "gtk-3.0" else ("true" if dark else "false"))
        write(os.path.join(CONFIG, "gtk-4.0/gtk.css"), gtk4_css(args[1]))
        for v in ("qt5ct", "qt6ct"):
            set_ini(os.path.join(CONFIG, v, v + ".conf"), "icon_theme", t["icons"])
        set_ini(os.path.join(CONFIG, "Kvantum/kvantum.kvconfig"), "theme", t["kvantum"])
        sh("flatpak", "override", "--user", f"--env=GTK_THEME={t['gtk']}")
        sh("gsettings", "set", iface, "gtk-theme", t["gtk"])
        sh("gsettings", "set", iface, "icon-theme", t["icons"])
        sh("gsettings", "set", iface, "color-scheme", t["scheme"])
        # GTK4 widget images follow the theme too.
        assets = os.path.join(CONFIG, "gtk-4.0/assets")
        if os.path.islink(assets) or not os.path.exists(assets):
            if os.path.islink(assets):
                os.remove(assets)
            os.symlink(os.path.join(HOME, ".local/share/themes", t["gtk"], "gtk-4.0/assets"), assets)
    elif args[:1] == ["accent"] and len(args) == 2 and args[1] in ACCENTS:
        # libadwaita apps follow org.gnome.desktop.interface accent-color.
        sh("gsettings", "set", iface, "accent-color", ACCENTS[args[1]])
    elif args[:1] == ["text-scale"] and len(args) == 2:
        f = float(args[1])
        if not 0.5 <= f <= 3:
            sys.exit("text scale must be 0.5-3")
        sh("gsettings", "set", iface, "text-scaling-factor", str(f))
    else:
        sys.exit(__doc__)


# ---------------------------------------------------------------- Standard apps (APP-4, APP-5)

DATA = os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share"))
USER_APPS = os.path.join(DATA, "applications")
ICONS = os.path.join(DATA, "clave/icons")
SETTINGS = os.path.join(CONFIG, "clave/settings.json")
OVERRIDE_MARK = "X-Clave-Override"

# Package -> the name the Dock, Apps and Search show (APP-1). Generic words
# (BR-3, BR-11); the package's own desktop file is looked up with pacman.
APP_NAMES = {
    "gnome-clocks": "Clock",
    "showtime": "Videos", "snapshot": "Camera",
    "gnome-logs": "Console",
    "hardinfo2": "System Information", "gnome-disk-utility": "Disk Utility",
    "seahorse": "Keychain", "timeshift": "Backups", "kitty": "Terminal",
}

# Launchers that only back a feature, configure a theme or come with a
# dependency (APP-10). Their copy gets NoDisplay=true: Apps, Search and the
# Dock leave them out, and xdg-open and MIME defaults still find them.
HIDDEN = [
    "org.pulseaudio.pavucontrol", "blueman-manager", "blueman-adapters",
    "system-config-printer", "cups", "opensnitch_ui",
    "qt5ct", "qt6ct", "kvantummanager", "nwg-look", "rofi", "rofi-theme-selector",
    "avahi-discover", "bssh", "bvnc", "lstopo", "qv4l2", "qvidcap",
    "org.gnome.FileRoller", "nm-connection-editor",
]

# Packages whose launchers stay visible without a new name (APP-10).
VISIBLE = ["nautilus", "gnome-text-editor", "gnome-calculator", "loupe", "evince", "papers"]

# MIME type -> package or desktop id of the default app (APP-5).
VIDEO = ["video/mp4", "video/x-matroska", "video/webm", "video/quicktime", "video/x-msvideo",
         "video/mpeg", "video/ogg", "video/x-m4v"]
MIME_DEFAULTS = {"clave-calendar.desktop": ["text/calendar"],
                 "showtime": VIDEO}


def package_desktop(pkg):
    """The visible desktop file a package installs, or None."""
    files = [l.split(" ", 1)[1] for l in sh("pacman", "-Ql", pkg).splitlines() if " " in l]
    for f in sorted(files, key=len):
        if f.startswith("/usr/share/applications/") and f.endswith(".desktop"):
            e = desktop(f)
            if e.get("Type") == "Application" and e.get("NoDisplay", "false") != "true":
                return f
    return None


def find_desktop(app_id):
    """A desktop id (with or without .desktop) looked up like app launchers do,
    skipping Clave's own overrides."""
    name = app_id if app_id.endswith(".desktop") else app_id + ".desktop"
    dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    for d in dirs:
        p = os.path.join(d, "applications", name)
        if os.path.isfile(p):
            return p
    return None


def settings_icons():
    try:
        with open(SETTINGS) as f:
            icons = json.load(f).get("icons", {})
        return icons if isinstance(icons, dict) else {}
    except (OSError, ValueError):
        return {}


def local_image(path):
    """A local PNG or SVG file (the wallpaper-portal check): resolved, a regular
    file, and of the right type by its content, not its name."""
    p = os.path.realpath(os.path.expanduser(path))
    if not os.path.isfile(p):
        return None, f"no such file: {path}"
    mime = sh("file", "--brief", "--mime-type", p).strip()
    if mime not in ("image/png", "image/svg+xml"):
        return None, f"not a PNG or SVG picture: {path} ({mime})"
    return p, mime


def icon_png(app_id, src):
    """Converts an icon to a 256 px PNG in ~/.local/share/clave/icons, as the
    user. Returns its path, or None with a reason on stderr."""
    p, mime = local_image(src)
    if not p:
        print(mime, file=sys.stderr)
        return None
    os.makedirs(ICONS, exist_ok=True)
    dst = os.path.join(ICONS, re.sub(r"[^A-Za-z0-9._-]", "_", app_id) + ".png")
    if mime == "image/svg+xml":
        cmd = ["rsvg-convert", "-w", "256", "-h", "256", "-a", p, "-o", dst + ".tmp"]
    else:
        cmd = ["magick", "png:" + p + "[0]", "-resize", "256x256", "-strip", "png:" + dst + ".tmp"]
    if subprocess.run(cmd, capture_output=True).returncode != 0:
        print(f"cannot read the picture: {src}", file=sys.stderr)
        return None
    os.replace(dst + ".tmp", dst)
    return dst


def write_override(src, name=None, icon=None, hide=False):
    """A copy of the desktop file in ~/.local/share/applications with Name=
    and/or Icon= changed, or hidden with NoDisplay=true. Exec and the rest stay the package's own, so the
    copy is written again at each install and update (APP-4)."""
    dst = os.path.join(USER_APPS, os.path.basename(src))
    if os.path.exists(dst) and OVERRIDE_MARK not in read(dst):
        return False          # the user's own file wins
    text = open(src).read()
    # Only the [Desktop Entry] group. Some files start with comments (hwloc's
    # lstopo.desktop), so the group is found by name, not taken from the top.
    start = max(text.find("[Desktop Entry]"), 0)
    end = text.find("\n[", start + 1)
    end = len(text) if end < 0 else end + 1
    pre, head, rest = text[:start], text[start:end], text[end:]
    if name:
        head = re.sub(r"^Name(\[[^\]]*\])?=.*\n?", "", head, flags=re.M)
        head = head.replace("[Desktop Entry]\n", f"[Desktop Entry]\nName={name}\n", 1)
    if icon:
        head = re.sub(r"^Icon=.*$", f"Icon={icon}", head, flags=re.M)
        if not re.search(r"^Icon=", head, re.M):
            head = head.rstrip("\n") + f"\nIcon={icon}\n"
    if hide:
        head = re.sub(r"^NoDisplay=.*\n?", "", head, flags=re.M)
        head = head.rstrip("\n") + "\nNoDisplay=true\n"
    head = head.rstrip("\n") + f"\n{OVERRIDE_MARK}=true\n"
    write(dst, pre + head + rest)
    return True


def apps(args):
    if args[:1] == ["names"]:
        # Names and icons for the standard apps, hidden helpers, icons for any
        # other app, and overrides whose app is gone are removed.
        icons = settings_icons()
        done = set()
        for app_id in HIDDEN:
            src = find_desktop(app_id)
            if src:
                icon = icons.get(app_id) or icons.get(app_id + ".desktop")
                write_override(src, icon=icon_png(app_id, icon) if icon else None, hide=True)
                done.add(os.path.basename(src))
        for pkg, name in APP_NAMES.items():
            src = package_desktop(pkg)
            if not src:
                continue
            app_id = os.path.basename(src)[:-len(".desktop")]
            icon = icons.get(app_id) or icons.get(app_id + ".desktop")
            write_override(src, name, icon_png(app_id, icon) if icon else None)
            done.add(os.path.basename(src))
        for app_id, icon in icons.items():
            src = find_desktop(app_id)
            if src and os.path.basename(src) not in done:
                png = icon_png(app_id, icon)
                if png:
                    write_override(src, icon=png)
                    done.add(os.path.basename(src))
        for p in glob.glob(os.path.join(USER_APPS, "*.desktop")):
            if OVERRIDE_MARK in read(p) and os.path.basename(p) not in done:
                os.unlink(p)
        sh("update-desktop-database", "-q", USER_APPS)
    elif args[:1] == ["unexpected"]:
        # A package in the default lists that shows a launcher in Apps, but is
        # neither hidden nor a known app (APP-10). One "package<TAB>file" line each.
        hidden = {h if h.endswith(".desktop") else h + ".desktop" for h in HIDDEN}
        for pkg in args[1:]:
            if pkg in APP_NAMES or pkg in VISIBLE:
                continue
            files = [l.split(" ", 1)[1] for l in sh("pacman", "-Ql", pkg).splitlines() if " " in l]
            for f in files:
                if not (f.startswith("/usr/share/applications/") and f.endswith(".desktop")):
                    continue
                name = os.path.basename(f)
                user = os.path.join(USER_APPS, name)
                e = desktop(user if os.path.exists(user) else f)
                if name in hidden or e.get("Type") != "Application" or e.get("NoDisplay", "false") == "true":
                    continue
                print(f"{pkg}\t{f}")
    elif args[:1] == ["defaults"]:
        # --missing-only: only types that have no default yet (updates).
        missing_only = "--missing-only" in args
        for app, types in MIME_DEFAULTS.items():
            src = os.path.join(USER_APPS, app) if app.endswith(".desktop") else package_desktop(app)
            if not src or not os.path.exists(src):
                continue
            for t in types:
                if missing_only and sh("xdg-mime", "query", "default", t).strip():
                    continue
                sh("xdg-mime", "default", os.path.basename(src), t)
    else:
        sys.exit(__doc__)


def icon(args):
    """icon set APP_ID FILE | icon reset APP_ID: the icons map in settings.json."""
    if args[:1] not in (["set"], ["reset"]) or len(args) != (3 if args[0] == "set" else 2):
        sys.exit(__doc__)
    app_id = args[1].removesuffix(".desktop")
    if not re.fullmatch(r"[A-Za-z0-9._-]+", app_id):
        sys.exit(f"not an app id: {args[1]}")
    if args[0] == "set":
        p, why = local_image(args[2])
        if not p:
            sys.exit(why)
    try:
        with open(SETTINGS) as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    icons = s.setdefault("icons", {})
    if args[0] == "set":
        icons[app_id] = args[2]
    else:
        icons.pop(app_id, None)
        png = os.path.join(ICONS, app_id + ".png")
        if os.path.exists(png):
            os.unlink(png)
    write(SETTINGS, json.dumps(s, indent=2) + "\n")
    apps(["names"])


def loginwindow(args):
    """Converts the picture as the user, then hands clave-admin the PNG on stdin."""
    if len(args) != 2 or args[0] not in ("background", "picture"):
        sys.exit(__doc__)
    what, src = args
    if what == "background" and src == "wallpaper":
        src = read(os.path.join(CONFIG, "clave/wallpaper")).strip()
    if not os.path.isfile(src):
        sys.exit(f"no such picture: {src}")
    if what == "background":
        size = ["-resize", "3840x2160^"]
    else:
        size = ["-thumbnail", "256x256^", "-gravity", "center", "-extent", "256x256"]
    png = subprocess.run(["magick", src + "[0]", "-auto-orient", *size, "-strip", "png:-"],
                         capture_output=True)
    if png.returncode != 0 or not png.stdout:
        sys.exit(f"cannot read the picture: {png.stderr.decode(errors='replace').strip()}")
    if what == "picture":
        face = os.path.join(HOME, ".face")
        with open(face + ".tmp", "wb") as f:
            f.write(png.stdout)
        os.replace(face + ".tmp", face)
    r = subprocess.run(["pkexec", "/usr/local/bin/clave-admin", "login-" + what],
                       input=png.stdout, capture_output=True)
    ok = r.returncode == 0
    sh("notify-send", "-a", "System Settings",
       "Login screen updated" if ok else "Login screen not changed",
       "The new picture shows at the next login." if ok else r.stderr.decode(errors="replace").strip())
    if not ok:
        sys.exit(1)


# ---------------------------------------------------------------- Lock screen

LOCK_PICTURE = os.path.join(HOME, ".local/share/clave/lock-background.png")


def lockscreen(args):
    """The lock screen background: the blurred wallpaper, or a picture of the
    user's, converted here to a PNG that clave-wallpaper hands to hyprlock."""
    if len(args) != 2 or args[0] != "background":
        sys.exit(__doc__)
    src = args[1]
    if src != "wallpaper":
        p = os.path.realpath(os.path.expanduser(src))
        if not os.path.isfile(p):
            sys.exit(f"no such picture: {src}")
        # Decode only JPEG, PNG and WebP, told explicitly (as clave-wallpaper does).
        coder = {"image/jpeg": "jpeg", "image/png": "png", "image/webp": "webp"}.get(
            sh("file", "--brief", "--mime-type", p).strip())
        if not coder:
            sys.exit(f"not a JPEG, PNG or WebP picture: {src}")
        os.makedirs(os.path.dirname(LOCK_PICTURE), exist_ok=True)
        r = subprocess.run(["magick", f"{coder}:{p}[0]", "-auto-orient", "-resize", "3840x2160^",
                            "-strip", "png:" + LOCK_PICTURE + ".tmp"], capture_output=True)
        if r.returncode != 0:
            sys.exit(f"cannot read the picture: {r.stderr.decode(errors='replace').strip()}")
        os.replace(LOCK_PICTURE + ".tmp", LOCK_PICTURE)
    try:
        with open(SETTINGS) as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    s.setdefault("lockScreen", {})["background"] = "wallpaper" if src == "wallpaper" else "picture"
    write(SETTINGS, json.dumps(s, indent=4) + "\n")
    ok = subprocess.run([os.path.join(HOME, ".local/bin/clave-wallpaper"), "--lock"]).returncode == 0
    if not ok:
        sys.exit("the lock screen picture was not made")


def main():
    a = sys.argv[1:]
    cmd, rest = (a[0], a[1:]) if a else ("", [])
    if cmd == "usb":
        usb()
    elif cmd == "battery":
        battery()
    elif cmd == "time":
        time_()
    elif cmd == "zones":
        out(sh("timedatectl", "list-timezones").split())
    elif cmd == "notify":
        notify(rest)
    elif cmd == "printers":
        printers(rest)
    elif cmd == "login":
        login(rest)
    elif cmd == "appearance":
        appearance(rest)
    elif cmd == "loginwindow":
        loginwindow(rest)
    elif cmd == "lockscreen":
        lockscreen(rest)
    elif cmd == "apps":
        apps(rest)
    elif cmd == "icon":
        icon(rest)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
