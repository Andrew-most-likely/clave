#!/usr/bin/env bash
# Does this Clave still work with the software installed now? Arch is a
# rolling release, so an ordinary update can break it. (PROJECT_PLAN.md COMP-8)
#
#   clave-doctor           local checks only, no network
#   clave-doctor --fetch   also fetch the newest signed Clave release and
#                          use its list of known breaks
#
# Local checks: Hyprland accepts the config; the Hyprland plugins were built
# for the Hyprland installed now; Quickshell's log has no QML errors; the GTK4
# theme assets are linked; no Clave user unit failed; the screen locks when
# idle (hypridle runs and its lock command exists); Apps shows no helper
# launchers that no list covers; and each package Clave
# talks to against compat.json: OK, Untested (newer than tested, no known
# break) or Update Clave (a known break that a newer Clave fixes).
# Exit status 1 when something needs doing. A command, not a service.
set -uo pipefail

repo=${CLAVE_REPO:-$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/clave/repo" 2>/dev/null || echo "$HOME/.local/src/clave")}
look="$HOME/.local/share/clave"
# Next to this file: works installed and from the checkout.
here=$(dirname "$(readlink -f "$0")")
fetch=0
case "${1:-}" in
    --fetch) fetch=1 ;;
    "") ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    *) echo "Usage: clave-doctor [--fetch]" >&2; exit 2 ;;
esac

if [ -t 1 ]; then g=$'\033[32m' y=$'\033[33m' r=$'\033[31m' b=$'\033[1m' n=$'\033[0m'
else g="" y="" r="" b="" n=""; fi
problems=0
ok()   { printf '  %s%-9s%s %s\n' "$g" OK "$n" "$1"; }
note() { printf '  %s%-9s%s %s\n' "$y" "$1" "$n" "$2"; }
bad()  { printf '  %s%-9s%s %s\n' "$r" "$1" "$n" "$2"; problems=$((problems + 1)); }
section() { printf '\n%s%s%s\n' "$b" "$1" "$n"; }

compat="$repo/compat.json"
[ -f "$compat" ] || compat=${CLAVE_SYSTEM_COMPAT:-/usr/share/clave/compat.json}
[ -f "$compat" ] || compat=""
clave=$([ -n "$compat" ] && jq -r '.clave // empty' "$compat" 2>/dev/null)
printf '%sClave %s%s\n' "$b" "${clave:-(release without a compatibility list)}" "$n"

# --- this machine -----------------------------------------------------------
section "Desktop"
if ! command -v Hyprland >/dev/null; then
    bad Problem "Hyprland is not installed"
elif Hyprland --verify-config -c "$HOME/.config/hypr/hyprland.lua" 2>&1 | grep -q 'config ok'; then
    ok "Hyprland accepts the config"
else
    bad Problem "Hyprland rejects the config: Hyprland --verify-config -c ~/.config/hypr/hyprland.lua"
fi

hash=$(sed -n 's/^#define GIT_COMMIT_HASH *"\(.*\)"/\1/p' /usr/include/hyprland/src/version.h 2>/dev/null)
built=$(cat "$look/plugins-hyprland" 2>/dev/null || true)
if [ -n "$hash" ] && [ "$built" = "$hash" ]; then
    ok "Plugins (traffic lights, genie) match this Hyprland"
elif [ -n "$built" ]; then
    bad Problem "Plugins were built for another Hyprland: run ~/.local/share/clave/rebuild-plugins.sh"
elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl plugin list 2>/dev/null | grep -q hyprbars; then
    ok "Plugins (traffic lights, genie) are loaded"
else
    note Unknown "Which Hyprland the plugins match: run ~/.local/share/clave/rebuild-plugins.sh once"
fi

if ! pgrep -u "$(id -u)" -x qs >/dev/null; then
    note Unknown "Quickshell is not running, so its log was not checked"
else
    errs=$(qs log -t 2000 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
        | grep -E '^ *ERROR|\.qml:[0-9]+(:[0-9]+)?: .*(Error|error|not defined|is not a type|Cannot assign)' | sort -u)
    if [ -z "$errs" ]; then ok "Quickshell log has no QML errors"
    else
        bad Problem "Quickshell log has $(wc -l <<< "$errs") QML errors, for example:"
        head -n 3 <<< "$errs" | cut -c1-160 | sed 's/^/              /'
    fi
fi

assets="$HOME/.config/gtk-4.0/assets"
if [ -e "$assets" ]; then ok "GTK4 theme assets are linked"
else bad Problem "GTK4 theme assets are missing ($assets): run $repo/install.sh --update"; fi

# The idle lock (ISSUE-6): hypridle.conf is the user's file, so an old
# lock command survives updates and the screen never locks.
idle="$HOME/.config/hypr/hypridle.conf"
lock_cmd=$(sed -n 's/^[[:space:]]*lock_cmd[[:space:]]*=[[:space:]]*//p' "$idle" 2>/dev/null | head -n1)
lock_bin=${lock_cmd%% *}
lock_bin=${lock_bin/#\~/$HOME}
if [ -z "$lock_cmd" ]; then
    bad Problem "The screen will not lock when idle: no lock_cmd in $idle (run: clave-idle repair)"
elif ! command -v "$lock_bin" >/dev/null 2>&1; then
    bad Problem "The screen will not lock when idle: $lock_bin is missing (run: clave-idle repair)"
elif ! pgrep -x hypridle >/dev/null; then
    bad Problem "The screen will not lock when idle: hypridle is not running (start it: hypridle &)"
else
    ok "The screen locks when idle"
fi

# Apps shows only apps a user opens on purpose (APP-10): a package in the
# default lists may bring a launcher that no list in clave-prefs covers.
pkgs=$(grep -vhE '^\s*(#|$)' "$repo"/packages/{core,desktop,look,apps,harden}.txt 2>/dev/null | tr -s ' \n' '\n' | grep -v '^$')
if [ -z "$pkgs" ]; then
    note Unknown "Launchers in Apps were not checked: no package lists in $repo"
else
    # shellcheck disable=SC2086
    extra=$("$here/clave-prefs" apps unexpected $pkgs 2>/dev/null)
    if [ -z "$extra" ]; then ok "Apps shows no helper launchers"
    else
        note Check "Launchers in Apps that Clave does not list (APP-10):"
        cut -f2 <<< "$extra" | sed 's/^/              /'
    fi
fi

units=()
for u in "$HOME"/.config/systemd/user/*.{service,timer}; do [ -e "$u" ] && units+=("${u##*/}"); done
failed=()
for u in "${units[@]}"; do systemctl --user is-failed -q "$u" 2>/dev/null && failed+=("$u"); done
if [ ${#failed[@]} -eq 0 ]; then ok "No Clave user service failed"
else bad Problem "Failed: ${failed[*]} (systemctl --user status ${failed[0]})"; fi

# --- packages -------------------------------------------------------------
newer=""
if [ "$fetch" -eq 1 ]; then
    section "Newest Clave release"
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    # shellcheck source=home/.local/share/clave/verify.sh
    . "$here/../share/clave/verify.sh"
    if ! git -C "$repo" fetch -q --tags origin 2>/dev/null; then
        note Unknown "Could not fetch $repo (offline?)"
    elif ref=$(newest_ref) && git -C "$repo" show "$ref:compat.json" > "$tmp" 2>/dev/null && jq -e . "$tmp" >/dev/null 2>&1; then
        latest=$(jq -r .clave "$tmp")
        newer=$tmp
        if [ "$(vercmp "$latest" "$clave")" -gt 0 ]; then note Update "Clave $latest is available: run clave-update"
        else ok "Clave $clave is the newest release"; fi
    else
        note Unknown "No signed compatibility list in the newest release"
    fi
fi

section "Packages (compat.json)"
results=""
if [ -z "$compat" ]; then
    note Unknown "This Clave release has no compat.json: run clave-update"
elif ! results=$("$here/clave-compat" -f "$compat" ${newer:+-r "$newer"}); then
    bad Problem "clave-compat could not read $compat"
    results=""
fi
while IFS=$'\t' read -r res pkg ver detail; do
    [ -n "$res" ] || continue
    case "$res" in
        OK) ok "$pkg $ver" ;;
        Untested) note Untested "$pkg $ver: $detail" ;;
        Update) bad "Update" "$pkg $ver: $detail" ;;
        Broken) bad "Broken" "$pkg $ver: $detail" ;;
    esac
done <<< "$results"

echo
if [ "$problems" -eq 0 ]; then echo "Nothing to do."; exit 0; fi
echo "$problems thing(s) need attention."
exit 1
