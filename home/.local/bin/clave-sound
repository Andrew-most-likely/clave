#!/usr/bin/env bash
# Plays one event sound, e.g. `clave-sound bell`. Uses the sounds built with
# clave-sounds-build when there are any, otherwise the freedesktop theme.
# Turned off in System Settings > Sound ("Play user interface sound effects").
[ -e "$HOME/.config/clave/mute-ui-sounds" ] && exit 0
f="$HOME/.local/share/sounds/clave/stereo/$1.oga"
if [ ! -f "$f" ]; then
    # The freedesktop theme names the login sound differently.
    event=$1
    [ "$event" = desktop-login ] && event=service-login
    f="/usr/share/sounds/freedesktop/stereo/$event.oga"
fi
[ -f "$f" ] || exit 0
# Volume feedback repeats while the key is held; don't stack the pops.
if [ "$1" = "audio-volume-change" ]; then
    pkill -f "pw-play .*audio-volume-change.oga" 2>/dev/null
fi
exec pw-play "$f"
