#!/usr/bin/env bash
# Plays one event sound, e.g. `clave-sound bell`. Uses the sounds built with
# clave-sounds-build when there are any, otherwise the freedesktop theme.
# Turned off in System Settings > Sound ("Play user interface sound effects").
#
# `clave-sound --notification [NAME]` plays the notification sound chosen in
# System Settings > Notifications (sound.notification in settings.json), or
# NAME as a preview. "none" plays nothing. It does not follow the switch for
# user interface sounds.
if [ "${1:-}" = --notification ]; then
    s=${2:-$(jq -r '.sound.notification // empty' "$HOME/.config/clave/settings.json" 2>/dev/null)}
    [[ "$s" =~ ^[a-z0-9-]+$ ]] || s=message-new-instant
    [ "$s" = none ] && exit 0
    set -- "$s"
elif [ -e "$HOME/.config/clave/mute-ui-sounds" ]; then
    exit 0
fi
f="$HOME/.local/share/sounds/clave/stereo/$1.oga"
if [ ! -f "$f" ]; then
    # The freedesktop theme names the login sound differently.
    event=$1
    [ "$event" = desktop-login ] && event=service-login
    f="/usr/share/sounds/freedesktop/stereo/$event.oga"
fi
[ -f "$f" ] || exit 0
# Volume feedback repeats while the key is held; don't stack the pops.
if [ "$1" = "audio-volume-change" ]; then
    pkill -f "pw-play .*audio-volume-change.oga" 2>/dev/null
fi
# No output device (or a busy one) is not an error: swaync would report
# every notification as a failed script.
pw-play "$f" 2>/dev/null || true
