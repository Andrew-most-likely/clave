#!/usr/bin/env bash
# Clipboard history (cliphist + rofi), with the switches in System Settings >
# Privacy & Security:
#   privacy.clipboardHistory  off: nothing is recorded (the history is wiped)
#   privacy.clipboardKeep     off: the history lives in $XDG_RUNTIME_DIR, in
#                             memory, and is gone after logout
#   privacy.clipboardImages   off: only text is recorded
# Copies that password managers mark as sensitive are never recorded.
#
#   clave-clipboard          pick an entry and copy it (Super+V)
#   clave-clipboard delete   pick an entry and delete it
#   clave-clipboard wipe     forget the whole history
#   clave-clipboard watch    start recording (at login)
#   clave-clipboard restart  apply changed settings
set -euo pipefail

settings=~/.config/clave/settings.json
setting() { jq -r --arg k "$1" --arg d "$2" '(.privacy // {})[$k] // $d | tostring' "$settings" 2>/dev/null || echo "$2"; }

runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
pids="$runtime/clave-clipboard.pids"
if [ "$(setting clipboardKeep false)" = true ]; then
    db="${XDG_CACHE_HOME:-$HOME/.cache}/cliphist/db"
else
    db="$runtime/cliphist/db"
fi
store=(cliphist -db-path "$db" -max-items 200)
theme=~/.config/rofi/clave-search.rasi

stop() {
    [ -f "$pids" ] || return 0
    while read -r pid; do kill "$pid" 2>/dev/null || true; done < "$pids"
    rm -f "$pids"
}

watch() {
    stop
    if [ "$(setting clipboardHistory true)" != true ]; then
        cliphist -db-path "$runtime/cliphist/db" wipe 2>/dev/null || true
        cliphist wipe 2>/dev/null || true
        return 0
    fi
    # Not kept after logout: nothing may stay on disk from earlier sessions.
    if [ "$(setting clipboardKeep false)" != true ]; then
        cliphist wipe 2>/dev/null || true
    fi
    # Private folder: only you can read the history.
    mkdir -p "$(dirname "$db")"
    chmod 700 "$(dirname "$db")"
    setsid wl-paste --type text --watch "${store[@]}" store >/dev/null 2>&1 &
    echo $! >> "$pids"
    if [ "$(setting clipboardImages false)" = true ]; then
        setsid wl-paste --type image --watch "${store[@]}" store >/dev/null 2>&1 &
        echo $! >> "$pids"
    fi
}

pick() { "${store[@]}" list | rofi -dmenu -i -p "$1" -theme "$theme" -display-columns 2; }

case "${1:-}" in
    watch|restart) watch ;;
    delete) sel=$(pick "Delete") && [ -n "$sel" ] && printf '%s' "$sel" | "${store[@]}" delete ;;
    wipe)   "${store[@]}" wipe && notify-send -a Clipboard "Clipboard history cleared" ;;
    "")
        if [ "$(setting clipboardHistory true)" != true ]; then
            notify-send -a Clipboard "Clipboard history is off" "Turn it on in System Settings > Privacy & Security."
            exit 0
        fi
        sel=$(pick "Clipboard") && [ -n "$sel" ] && printf '%s' "$sel" | "${store[@]}" decode | wl-copy ;;
    *) sed -n '2,15p' "$0" | cut -c3-; exit 1 ;;
esac
