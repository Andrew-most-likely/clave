#!/usr/bin/env python3
"""Calendar files for the Clave Calendar app (PROJECT_PLAN.md APP-8).
Open-source libraries read and write the format (icalendar, python-dateutil
for repeating events); the app only draws. Plain files, no sync, no network:
other apps and backups can read them, and importing a file means copying it
into the folder.

  ~/.local/share/clave/calendars/NAME.ics    one file per calendar

  clave-pim calendars                         calendars as JSON
  clave-pim calendar-new NAME [COLOR]
  clave-pim calendar-set CAL name|color VALUE
  clave-pim calendar-delete CAL
  clave-pim events START END                  events in [START, END) (ISO
                                              dates), repeats expanded
  clave-pim event-save < JSON                 add or change one event
  clave-pim event-delete CAL UID [DATE]       DATE: only that repeat
  clave-pim import FILE                       copy an .ics file in

Errors are one line on stderr (the app shows them), never a traceback.
"""
import datetime as dt
import json
import os
import re
import shutil
import sys
import uuid

DATA = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
CAL_DIR = os.path.join(DATA, "clave/calendars")
COLORS = ["#0a84ff", "#30d158", "#ff453a", "#ff9f0a", "#bf5af2", "#ffd60a", "#64d2ff"]
NAME_RE = re.compile(r"[^\w .,()'-]+")


def fail(msg):
    sys.exit(msg)


def out(v):
    print(json.dumps(v, ensure_ascii=False))


def libs():
    try:
        import icalendar  # noqa: F401
        from dateutil import rrule  # noqa: F401
    except ImportError as e:
        fail(f"missing library: {e.name} (install python-icalendar, python-dateutil)")


def write_atomic(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def safe_id(s):
    """A file stem from a name: no path separators, no dot files."""
    s = NAME_RE.sub("", s).strip().strip(".")
    return s[:80] or "Calendar"


# ---------------------------------------------------------------- Calendars

def cal_path(cal):
    p = os.path.join(CAL_DIR, os.path.basename(cal) + ".ics")
    if os.path.dirname(os.path.realpath(p)) != os.path.realpath(CAL_DIR):
        fail(f"bad calendar: {cal}")
    return p


def load_cal(cal):
    from icalendar import Calendar
    with open(cal_path(cal), "rb") as f:
        return Calendar.from_ical(f.read())


def save_cal(cal, c):
    write_atomic(cal_path(cal), c.to_ical())


def new_cal(name, color=None):
    from icalendar import Calendar
    c = Calendar()
    c.add("prodid", "-//Clave//Calendar//EN")
    c.add("version", "2.0")
    c.add("x-wr-calname", name)
    c.add("x-clave-color", color or COLORS[len(cal_ids()) % len(COLORS)])
    return c


def cal_ids():
    if not os.path.isdir(CAL_DIR):
        return []
    return sorted(f[:-4] for f in os.listdir(CAL_DIR) if f.endswith(".ics") and not f.startswith("."))


def calendars():
    if not cal_ids():
        # A first calendar, so the app has somewhere to put events.
        save_cal("Calendar", new_cal("Calendar", COLORS[0]))
    res = []
    for i, cid in enumerate(cal_ids()):
        try:
            c = load_cal(cid)
        except (OSError, ValueError) as e:
            res.append({"id": cid, "name": cid, "color": "#8e8e93", "error": str(e)})
            continue
        res.append({"id": cid, "name": str(c.get("x-wr-calname", cid)),
                    "color": str(c.get("x-clave-color", COLORS[i % len(COLORS)]))})
    return res


def as_dt(v, tz=None):
    """A date or datetime from icalendar as a local, naive datetime."""
    if isinstance(v, dt.datetime):
        if v.tzinfo is not None:
            v = v.astimezone().replace(tzinfo=None)
        return v
    return dt.datetime.combine(v, dt.time())


def parse_iso(s):
    s = s.strip()
    if len(s) == 10:
        return dt.datetime.fromisoformat(s)
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone().replace(tzinfo=None) \
        if ("+" in s[10:] or s.endswith("Z")) else dt.datetime.fromisoformat(s)


def expand(ev, start, end):
    """Occurrences of one VEVENT that overlap [start, end), as (start, end)."""
    from dateutil import rrule
    s0 = ev.get("dtstart").dt
    all_day = not isinstance(s0, dt.datetime)
    s = as_dt(s0)
    if ev.get("dtend") is not None:
        e = as_dt(ev.get("dtend").dt)
    elif ev.get("duration") is not None:
        e = s + ev.get("duration").dt
    else:
        e = s + (dt.timedelta(days=1) if all_day else dt.timedelta(0))
    length = e - s
    if ev.get("rrule") is None:
        return [(s, e)] if s < end and e > start else [], all_day
    rule = rrule.rrulestr(ev.get("rrule").to_ical().decode(), dtstart=s, ignoretz=True, forceset=True)
    for ex in ev.get("exdate", []) if isinstance(ev.get("exdate"), list) else [ev.get("exdate")] if ev.get("exdate") else []:
        for d in ex.dts:
            rule.exdate(as_dt(d.dt))
    occ = rule.between(start - length, end, inc=True)
    return [(o, o + length) for o in occ if o < end and o + length > start], all_day


def events(start_s, end_s):
    start, end = parse_iso(start_s), parse_iso(end_s)
    res = []
    for cal in calendars():
        if cal.get("error"):
            continue
        c = load_cal(cal["id"])
        overridden = {}
        for ev in c.walk("VEVENT"):
            if ev.get("recurrence-id") is not None:
                overridden.setdefault(str(ev.get("uid")), set()).add(as_dt(ev.get("recurrence-id").dt))
        for ev in c.walk("VEVENT"):
            if ev.get("dtstart") is None:
                continue
            uid = str(ev.get("uid", ""))
            is_override = ev.get("recurrence-id") is not None
            try:
                occ, all_day = expand(ev, start, end)
            except (ValueError, TypeError):
                continue
            for s, e in occ:
                if not is_override and s in overridden.get(uid, set()):
                    continue
                res.append({
                    "calendar": cal["id"], "color": cal["color"], "uid": uid,
                    "repeats": ev.get("rrule") is not None,
                    "repeat": str(ev.get("rrule").get("FREQ", [""])[0]).lower() if ev.get("rrule") else "",
                    "occurrence": s.isoformat(),
                    "title": str(ev.get("summary", "")), "location": str(ev.get("location", "")),
                    "notes": str(ev.get("description", "")),
                    "start": s.isoformat(), "end": e.isoformat(), "allDay": all_day,
                })
    res.sort(key=lambda r: (r["start"], r["title"]))
    return res


def event_save(data):
    """{calendar, uid?, title, location, notes, start, end, allDay, repeat:
    ""|daily|weekly|monthly|yearly, oldCalendar?}. A new uid when missing."""
    from icalendar import Event, vRecur
    cal = data.get("calendar") or "Calendar"
    old = data.get("oldCalendar")
    uid = data.get("uid") or f"{uuid.uuid4()}@clave"
    if old and old != cal:
        event_delete(old, uid)
    c = load_cal(cal) if os.path.exists(cal_path(cal)) else new_cal(cal)
    master = next((e for e in c.walk("VEVENT") if str(e.get("uid")) == uid and e.get("recurrence-id") is None), None)
    if master is None:
        master = Event()
        master.add("uid", uid)
        master.add("created", dt.datetime.now(dt.timezone.utc))
        c.add_component(master)
    s, e = parse_iso(data["start"]), parse_iso(data["end"])
    all_day = bool(data.get("allDay"))
    # A change made on a later repeat moves the whole series by the same
    # amount from its own start, not to that repeat's date.
    if data.get("occurrence") and master.get("rrule") is not None and master.get("dtstart") is not None:
        delta = s - parse_iso(data["occurrence"])
        length = e - s
        s = as_dt(master.get("dtstart").dt) + delta
        e = s + length
    for k in ("summary", "location", "description", "dtstart", "dtend", "rrule", "dtstamp", "last-modified", "duration"):
        master.pop(k, None)
    master.add("summary", data.get("title") or "New Event")
    if data.get("location"):
        master.add("location", data["location"])
    if data.get("notes"):
        master.add("description", data["notes"])
    if all_day:
        master.add("dtstart", s.date())
        master.add("dtend", max(e.date(), s.date() + dt.timedelta(days=1)))
    else:
        # Local wall-clock time with the system zone, so it stays put when
        # the computer travels with a calendar that is shared as a file.
        master.add("dtstart", s.astimezone())
        master.add("dtend", max(e, s).astimezone())
    freq = (data.get("repeat") or "").upper()
    if freq in ("DAILY", "WEEKLY", "MONTHLY", "YEARLY"):
        master.add("rrule", vRecur({"FREQ": freq}))
    now = dt.datetime.now(dt.timezone.utc)
    master.add("dtstamp", now)
    master.add("last-modified", now)
    save_cal(cal, c)
    out({"calendar": cal, "uid": uid})


def event_delete(cal, uid, date=None):
    c = load_cal(cal)
    if date:
        # One repeat: an EXDATE on the repeating event.
        d = parse_iso(date)
        for e in c.walk("VEVENT"):
            if str(e.get("uid")) == uid and e.get("recurrence-id") is None:
                e.add("exdate", d if isinstance(e.get("dtstart").dt, dt.datetime) and d.tzinfo else
                      (d.astimezone() if isinstance(e.get("dtstart").dt, dt.datetime) else d.date()))
    else:
        c.subcomponents = [e for e in c.subcomponents if not (e.name == "VEVENT" and str(e.get("uid")) == uid)]
    save_cal(cal, c)


def import_file(src):
    from icalendar import Calendar
    src = os.path.realpath(os.path.expanduser(src))
    if not os.path.isfile(src):
        fail(f"no such file: {src}")
    if not src.lower().endswith(".ics"):
        fail("only .ics calendar files can be imported")
    # Checked by reading it before it is copied in.
    try:
        with open(src, "rb") as f:
            Calendar.from_ical(f.read())
    except ValueError:
        fail(f"{os.path.basename(src)} is not a calendar file that can be read")
    base = safe_id(os.path.splitext(os.path.basename(src))[0])
    dst, n = os.path.join(CAL_DIR, base + ".ics"), 2
    while os.path.exists(dst):
        dst, n = os.path.join(CAL_DIR, f"{base} {n}.ics"), n + 1
    os.makedirs(CAL_DIR, exist_ok=True)
    shutil.copyfile(src, dst)
    out({"file": dst})


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else ""
    if cmd in ("", "-h", "--help"):
        fail(__doc__)
    libs()
    if cmd == "calendars":
        out(calendars())
    elif cmd == "calendar-new" and len(a) in (2, 3):
        cid = safe_id(a[1])
        if os.path.exists(cal_path(cid)):
            fail(f"a calendar named {cid} exists")
        save_cal(cid, new_cal(a[1], a[2] if len(a) == 3 else None))
        out({"id": cid})
    elif cmd == "calendar-set" and len(a) == 4 and a[2] in ("name", "color"):
        c = load_cal(a[1])
        key = "x-wr-calname" if a[2] == "name" else "x-clave-color"
        c.pop(key, None)
        c.add(key, a[3])
        save_cal(a[1], c)
    elif cmd == "calendar-delete" and len(a) == 2:
        os.unlink(cal_path(a[1]))
    elif cmd == "events" and len(a) == 3:
        out(events(a[1], a[2]))
    elif cmd == "event-save":
        event_save(json.load(sys.stdin))
    elif cmd == "event-delete" and len(a) in (3, 4):
        event_delete(a[1], a[2], a[3] if len(a) == 4 else None)
    elif cmd == "import" and len(a) == 2:
        import_file(a[1])
    else:
        fail(__doc__)


if __name__ == "__main__":
    try:
        main()
    except json.JSONDecodeError:
        fail("clave-pim: the event data was not valid JSON")
    except (KeyError, TypeError) as e:
        fail(f"clave-pim: the event data is missing a field: {e}")
    except (OSError, ValueError) as e:
        # A calendar file that cannot be read or written: say which, in one line.
        fail(f"clave-pim: {e}")
