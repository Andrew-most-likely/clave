#!/usr/bin/env bash
# Lock, sleep, log out, restart, shut down.
# Usage: clave-power -l|--lock -d|--display-off -s|--suspend -e|--logout -r|--reboot -p|--poweroff
set -u
case "${1:-}" in
    -l|--lock)     pidof hyprlock >/dev/null || exec hyprlock ;;
    # Lock first: a dark screen must never hide an unlocked session.
    -d|--display-off)
        pidof hyprlock >/dev/null || { hyprlock & sleep 1; }
        exec hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })' ;;
    -s|--suspend)  exec systemctl suspend ;;
    -e|--logout)   exec hyprctl dispatch 'hl.dsp.exit()' ;;
    -r|--reboot)   exec systemctl reboot ;;
    -p|--poweroff) exec systemctl poweroff ;;
    *) sed -n '3p' "$0" | cut -c3-; exit 1 ;;
esac
