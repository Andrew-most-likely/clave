# macOS-style boot splash: Apple logo centred on black, thin progress bar below.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();
ox = Window.GetX();
oy = Window.GetY();

# Logo: about 9% of the screen height, a little above the centre.
logo_src = Image("logo.png");
logo_h = Math.Int(sh * 0.09);
logo_w = Math.Int(logo_src.GetWidth() * logo_h / logo_src.GetHeight());
logo = Sprite(logo_src.Scale(logo_w, logo_h));
logo.SetX(ox + Math.Int((sw - logo_w) / 2));
logo_y = oy + Math.Int(sh / 2 - logo_h / 2 - sh * 0.04);
logo.SetY(logo_y);
logo.SetZ(10);

# Progress bar: about 12% of the screen width, 0.3% of its height.
bar_w = Math.Int(sw * 0.12);
bar_h = Math.Int(sh * 0.003);
if (bar_h < 4) bar_h = 4;
bar_x = ox + Math.Int((sw - bar_w) / 2);
bar_y = logo_y + logo_h + Math.Int(sh * 0.09);

fill_src = Image("fill.png");
track = Sprite(Image("track.png").Scale(bar_w, bar_h));
track.SetPosition(bar_x, bar_y, 20);
fill = Sprite();
fill.SetPosition(bar_x, bar_y, 21);

# Only boot and upgrades show the bar; shutdown and reboot show the logo alone.
if (Plymouth.GetMode() != "boot" && Plymouth.GetMode() != "updates") {
    track.SetOpacity(0);
}

fun progress_callback(duration, progress) {
    if (Plymouth.GetMode() != "boot" && Plymouth.GetMode() != "updates") return;
    w = Math.Int(bar_w * progress);
    if (w < bar_h) w = bar_h;
    fill.SetImage(fill_src.Scale(w, bar_h));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Password prompt (only used if a disk is ever encrypted): a row of dots.
prompt = Sprite();
bullets = Sprite();
fun display_password_callback(text, count) {
    prompt.SetImage(Image.Text(text, 1, 1, 1, 1, "SF Pro Text 12"));
    prompt.SetPosition(ox + Math.Int((sw - prompt.GetImage().GetWidth()) / 2), bar_y + bar_h * 6, 30);
    dots = "";
    for (i = 0; i < count; i++) dots += "●";
    bullets.SetImage(Image.Text(dots, 1, 1, 1, 1, "SF Pro Text 14"));
    bullets.SetPosition(ox + Math.Int((sw - bullets.GetImage().GetWidth()) / 2), bar_y + bar_h * 12, 30);
    track.SetOpacity(0);
    fill.SetOpacity(0);
}
fun display_normal_callback() {
    prompt.SetOpacity(0);
    bullets.SetOpacity(0);
    if (Plymouth.GetMode() == "boot" || Plymouth.GetMode() == "updates") {
        track.SetOpacity(1);
        fill.SetOpacity(1);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

message = Sprite();
fun message_callback(text) {
    message.SetImage(Image.Text(text, 0.6, 0.6, 0.6, 1, "SF Pro Text 11"));
    message.SetPosition(ox + Math.Int((sw - message.GetImage().GetWidth()) / 2), oy + sh - sh * 0.08, 30);
}
Plymouth.SetMessageFunction(message_callback);
