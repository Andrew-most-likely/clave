# Boot splash: Clave logo centred on black, thin progress bar below.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();
ox = Window.GetX();
oy = Window.GetY();

# Logo: about 9% of the screen height, a little above the centre.
logo_src = Image("logo.png");
logo_h = Math.Int(sh * 0.09);
logo_w = Math.Int(logo_src.GetWidth() * logo_h / logo_src.GetHeight());
logo = Sprite(logo_src.Scale(logo_w, logo_h));
logo.SetX(ox + Math.Int((sw - logo_w) / 2));
logo_y = oy + Math.Int(sh / 2 - logo_h / 2 - sh * 0.04);
logo.SetY(logo_y);
logo.SetZ(10);

# Progress bar: about 12% of the screen width, 0.3% of its height.
bar_w = Math.Int(sw * 0.12);
bar_h = Math.Int(sh * 0.003);
if (bar_h < 4) bar_h = 4;
bar_x = ox + Math.Int((sw - bar_w) / 2);
bar_y = logo_y + logo_h + Math.Int(sh * 0.09);

fill_src = Image("fill.png");
track = Sprite(Image("track.png").Scale(bar_w, bar_h));
track.SetPosition(bar_x, bar_y, 20);
fill = Sprite();
fill.SetPosition(bar_x, bar_y, 21);

# Only boot and upgrades show the bar; shutdown and reboot show the logo alone.
if (Plymouth.GetMode() != "boot" && Plymouth.GetMode() != "updates") {
    track.SetOpacity(0);
}

fun progress_callback(duration, progress) {
    if (Plymouth.GetMode() != "boot" && Plymouth.GetMode() != "updates") return;
    w = Math.Int(bar_w * progress);
    if (w < bar_h) w = bar_h;
    fill.SetImage(fill_src.Scale(w, bar_h));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Disk Encryption passphrase (SEC-5): the lock screen's pill-shaped field
# under the logo, with the prompt as a caption and one dot per character.
field_h = Math.Int(sh * 0.032);
if (field_h < 28) field_h = 28;
field_w = Math.Int(field_h * 380 / 64);
field_x = ox + Math.Int((sw - field_w) / 2);
field_y = logo_y + logo_h + Math.Int(sh * 0.07);
field = Sprite(Image("field.png").Scale(field_w, field_h));
field.SetPosition(field_x, field_y, 29);
field.SetOpacity(0);
prompt = Sprite();
bullets = Sprite();
answer = Sprite();

fun show_field(caption) {
    prompt.SetImage(Image.Text(caption, 1, 1, 1, 0.8, "Inter 11"));
    prompt.SetPosition(ox + Math.Int((sw - prompt.GetImage().GetWidth()) / 2),
                       field_y + field_h + Math.Int(field_h * 0.5), 30);
    field.SetOpacity(1);
    prompt.SetOpacity(1);
    track.SetOpacity(0);
    fill.SetOpacity(0);
}
fun centre_in_field(sprite) {
    sprite.SetPosition(ox + Math.Int((sw - sprite.GetImage().GetWidth()) / 2),
                       field_y + Math.Int((field_h - sprite.GetImage().GetHeight()) / 2), 31);
}
fun display_password_callback(text, count) {
    if (text == "") text = "Enter Disk Password";
    show_field(text);
    answer.SetOpacity(0);
    dots = "";
    for (i = 0; i < count; i++) dots += "●";
    if (dots == "") dots = " ";
    bullets.SetImage(Image.Text(dots, 1, 1, 1, 1, "Inter 10"));
    centre_in_field(bullets);
    bullets.SetOpacity(1);
}
# Plain-text questions (rare: for example a key file path).
fun display_question_callback(text, entry) {
    show_field(text);
    bullets.SetOpacity(0);
    if (entry == "") entry = " ";
    answer.SetImage(Image.Text(entry, 1, 1, 1, 1, "Inter 11"));
    centre_in_field(answer);
    answer.SetOpacity(1);
}
fun display_normal_callback() {
    field.SetOpacity(0);
    prompt.SetOpacity(0);
    bullets.SetOpacity(0);
    answer.SetOpacity(0);
    if (Plymouth.GetMode() == "boot" || Plymouth.GetMode() == "updates") {
        track.SetOpacity(1);
        fill.SetOpacity(1);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

message = Sprite();
fun message_callback(text) {
    message.SetImage(Image.Text(text, 0.6, 0.6, 0.6, 1, "Inter 11"));
    message.SetPosition(ox + Math.Int((sw - message.GetImage().GetWidth()) / 2), oy + sh - sh * 0.08, 30);
}
Plymouth.SetMessageFunction(message_callback);
